# ============================================
# Recruiter Mail Automation - Environment Config
# ============================================

# Your Gmail address (the account you'll send emails FROM)
EMAIL_USER=your-email@gmail.com

# Gmail App Password (NOT your regular Gmail password!)
# To generate:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Factor Authentication
#   3. Go to "App passwords" (search in Google Account settings)
#   4. Select "Mail" and your device, then click "Generate"
#   5. Copy the 16-character password and paste it here
EMAIL_PASS=xxxx xxxx xxxx xxxx

# Server port (optional, defaults to 3000)
PORT=3000
